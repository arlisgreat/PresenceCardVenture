# 仅服务端。密钥不进 Git、不传 Web。两家任选一家，不自动跨供应商切换。
AI_PROVIDER=qwen
DASHSCOPE_API_KEY=
IMAGE_MODEL=qwen-image-3.0-pro
# 端点与 API Key/模型地域必须一致；可替换成对应 workspace 北京端点。
QWEN_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
IMAGE_TIMEOUT_MS=180000
# 对照组：AI_PROVIDER=openai，IMAGE_MODEL=gpt-image-2-2026-04-21
OPENAI_API_KEY=
OPENAI_IMAGE_QUALITY=medium
