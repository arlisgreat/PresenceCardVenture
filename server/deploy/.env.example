# 复制为 .env 并填值（.env 不入库）
API_DOMAIN=api-dev.example.com
APP_DOMAIN=app-dev.example.com
POSTGRES_PASSWORD=CHANGE_ME

# api 服务通过本文件注入；容器内 DATABASE_URL 的主机名必须是 db
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/presence
PORT=3000
UPLOAD_DAILY_LIMIT=60
REQUIRE_PRODUCTION_SERVICES=true

# 真实生产适配器配置；未填写时 /health/ready 会保持 503
OSS_BUCKET=
AI_PROVIDER=

# 本地开发可参考 server/api/.env.example；不要把密钥提交到仓库
