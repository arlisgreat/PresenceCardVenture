# 复制为 .env 并填值（.env 不入库）
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/presence"
PORT=3000

# 阿里云 OSS（私有桶）——docs/01 §5
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=presence-card-photos
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_URL_EXPIRES_SECONDS=600

# 生产就绪校验：填写真实适配器名称（禁止使用 demo/local/simulator）
AI_PROVIDER=
REQUIRE_PRODUCTION_SERVICES=false

# 限额 —— docs/02 §0/§2
UPLOAD_DAILY_LIMIT=60
UPLOAD_MAX_BYTES=1048576
