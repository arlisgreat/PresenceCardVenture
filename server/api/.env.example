# 复制为 .env 并填值（.env 不入库）
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/presence"
PORT=3000

# 阿里云 OSS（私有桶）——docs/01 §5
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=presence-card-photos
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_URL_EXPIRES_SECONDS=600

# 限额 —— docs/02 §0/§2
UPLOAD_DAILY_LIMIT=60
UPLOAD_MAX_BYTES=1048576
