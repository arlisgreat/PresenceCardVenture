# ============================================================
# M5Stack CoreS3 美颜相机 sdkconfig 默认项
# ============================================================
CONFIG_IDF_TARGET="esp32s3"

# --- 性能: 双核 240MHz，开 PSRAM ---
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# >=512B 的 malloc 优先 PSRAM (真机: BLE 配网时内部堆只差 ~15KB, 中等分配
# 全挪外部; WiFi/BLE 驱动走显式 heap_caps 内部分配不受影响)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512

# S3 I/D-Cache 扩容至 32KB: 像素算子 / 滤波 LUT / 缩放行缓冲命中率提升,
# 对逐像素渲染收益明显 (代价: 片内 SRAM 各减 16KB, CoreS3 仍有 512KB 足够)
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_32KB=y

# --- 中文字体 (P0: 默认 Montserrat 无 CJK 字形, 中文会渲染为方块) ---
# 中文用自制 Noto Sans SC 16 (main/pvc_font_cn16.c, tools/make_cn_font.sh):
# 内置 Source Han 16 CJK 仅 1187 字稀疏子集, UI 用字缺 59 个成乱码, 已弃用
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_14=y

# --- LVGL 全尺寸缓冲(320x240x2B)放 PSRAM ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="stdlib.h"
CONFIG_LV_MEM_CUSTOM_ALLOC=malloc
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_QRCODE=y

# --- 摄像头与文件系统 ---
CONFIG_FATFS_LFN_HEAP=y
# CoreS3 板载 16MB flash (PlatformIO 默认探测可能误判为 2MB)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- 任务栈 (栈溢出 review) ---
# esp_event 系统任务默认 2304B 过小 (wifi/prov 事件回调在其栈上, ESP_LOG 即近极限)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# main 任务默认 3584B: app_main 里创建整套 LVGL UI, 加大到 6144
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# 栈溢出金丝雀检测 (IDF 默认已开, 显式声明防误关)
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# --- BLE 配网 (wifi_provisioning + NimBLE, 比 Bluedroid 省 ~100KB) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# --- 联网 (Presence Card docs/02 §6) ---
# HTTPS 证书校验走 IDF 内置 bundle (含 ISRG Root X1); 禁止 skip_cert_verify
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# TLS 握手 ~40KB 堆, mbedTLS 缓冲放 PSRAM 之外的默认堆即可 (CoreS3 SRAM 足够)

# --- 堆完整性 (联调/仿真期开启, 每块前后毒化字节, malloc/free 校验; 发布可关) ---
CONFIG_HEAP_POISONING_COMPREHENSIVE=y

# --- 日志 ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- OTA (docs/02 §3.1 fw_latest) ---
# 回滚保护: 新固件首次启动为 PENDING_VERIFY, 自检 (首次 feed 同步成功) 后
# pvc_ota_mark_valid() 落账; 未落账即重启/崩溃则 bootloader 自动回滚旧槽
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- 内部 SRAM 压力 (真机实测: BLE 控制器 init OOM -> IDF deinit 路径崩溃循环) ---
# NimBLE 主机堆放 PSRAM; WiFi/LWIP 缓冲优先 PSRAM; 显示缓冲已缩至 320x24x2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# LVGL 用 clib malloc 替代 64KB 内部静态池 (work_mem_int, 真机 .bss 最大头):
# 小对象经 SPIRAM_MALLOC_ALWAYSINTERNAL 仍走内部, 但 64KB 不再整块占死
CONFIG_LV_USE_CLIB_MALLOC=y
# 相机 DMA 降 16KB (QVGA 中断频率仍低), WiFi 静态 RX 10->8: 内部堆再省 ~20KB
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=32768
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_RX_BA_WIN=6
# BLE 仅用于配网 (1 个从连接): 控制器活动数 6->2, 省内部堆
CONFIG_BT_CTRL_BLE_MAX_ACT=2
